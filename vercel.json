{
  "version": 2,
  "framework": null,
  "outputDirectory": ".",
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "arcade.css",
      "use": "@vercel/static"
    },
    {
      "src": "zidea-home.css",
      "use": "@vercel/static"
    },
    {
      "src": "arcade.js",
      "use": "@vercel/static"
    },
    {
      "src": "zidea-kb.js",
      "use": "@vercel/static"
    },
    {
      "src": "assets/*.png",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
